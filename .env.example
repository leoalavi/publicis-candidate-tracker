# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API Keys.
#
# These variables do NOT start with NEXT_PUBLIC_, so Next.js never sends them
# to the browser. They are only readable in server code (our API routes).

SUPABASE_URL=https://your-project-ref.supabase.co

# The SECRET key (starts with sb_secret_...) or the legacy service_role key.
# Never commit this value and never expose it to the browser.
SUPABASE_SECRET_KEY=

# Google Gemini API key for the AI summary feature.
# Create one at https://aistudio.google.com/apikey (free tier, no billing needed).
# Without it the app still works; only "Generate AI summary" shows a configuration error.
GEMINI_API_KEY=
